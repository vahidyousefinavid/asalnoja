# آدرس اصلی سایت (برای سئو، sitemap و لینک‌های canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL
# برای توسعه محلی، `npm run db:dev` یک PostgreSQL واقعی روی پورت 5433 بالا می‌آورد.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/asalnoja
# برای سرویس‌های ابری که SSL می‌خواهند (Neon، Supabase، Liara و ...) true کنید
DATABASE_SSL=false

# کلید امضای نشست ادمین (حداقل ۳۲ کاراکتر تصادفی)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# حساب ادمین اولیه که اسکریپت seed می‌سازد
ADMIN_EMAIL=admin@asalnoja.ir
ADMIN_PASSWORD=admin12345
